{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ "
      }
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Archive": {
    "MaxRetries": 3,
    "RetryDelay": "00:00:05",
    "AttemptTimeout": "00:00:10",
    "ContentTimeout": "00:01:30"
  },
  "AllowedHosts": "*"
}