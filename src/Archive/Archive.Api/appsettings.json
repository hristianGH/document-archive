{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ "
      }
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Paging": {
    "MaxPageSize": 5
  },
  "Upload": {
    "MaxZipBytes": 1048576,
    "MaxUncompressedBytes": 5242880,
    "MaxEntries": 1000
  },
  "AllowedHosts": "*"
}
